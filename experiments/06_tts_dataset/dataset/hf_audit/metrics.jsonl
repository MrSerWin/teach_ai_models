{"score": -0.1563, "min_wscore": -0.556, "n_weak": 0, "char_rate": 8.43, "dur": 6.06, "n_words": 5, "id": "hf_sevil_1336", "text": "Qara haberni yaqınla­rıñızğa aytmaq kereksiñiz"}
{"score": -0.1384, "min_wscore": -0.48, "n_weak": 0, "char_rate": 6.18, "dur": 5.82, "n_words": 7, "id": "hf_sevil_0388", "text": "Katâ deşet tolu közlerinen oña baqa edi"}
