{"score": -0.1201, "min_wscore": -0.334, "n_weak": 0, "char_rate": 6.98, "dur": 4.08, "n_words": 4, "id": "hf_sevil_1366", "text": "Aliyeniñ yüregi kene titredi"}
{"score": -0.1723, "min_wscore": -0.569, "n_weak": 0, "char_rate": 8.39, "dur": 6.42, "n_words": 9, "id": "hf_sevil_0539", "text": "Ertesi künü Akim etrafnı biraz ögrenmek içün yolğa çıqtı"}
{"score": -0.2446, "min_wscore": -1.185, "n_weak": 0, "char_rate": 8.82, "dur": 9.54, "n_words": 13, "id": "hf_sevil_0704", "text": "O vaqıt oña kimse inanmadı, suvsızlıqtan aqıldan azıp başladı, ğaliba, dep tüşüngenler oldı"}
{"score": -0.8632, "min_wscore": -6.298, "n_weak": 3, "char_rate": 11.83, "dur": 3.96, "n_words": 8, "id": "hf_sevil_0863", "text": "Peyda olğan müitni  iç kimse coymağa istemey edi"}
{"score": -0.1091, "min_wscore": -0.878, "n_weak": 0, "char_rate": 8.88, "dur": 7.68, "n_words": 11, "id": "hf_sevil_0773", "text": "Qadın esini coyacaq alda, azbarda onı beklep turğan adamlarğa taba adımladı"}
{"score": -0.1526, "min_wscore": -0.545, "n_weak": 0, "char_rate": 5.59, "dur": 3.779, "n_words": 3, "id": "hf_sevil_0908", "text": "Sizce bu külünçlimi"}
{"score": -0.2784, "min_wscore": -0.999, "n_weak": 0, "char_rate": 9.68, "dur": 8.28, "n_words": 13, "id": "hf_sevil_0255", "text": "Men onı minetdarlıq ile sıq-sıq hatırlayım, hasta babamdan Zekiye haber alıp tura edi"}
{"score": -0.232, "min_wscore": -0.641, "n_weak": 0, "char_rate": 8.5, "dur": 7.679, "n_words": 9, "id": "hf_sevil_0449", "text": "Cerrah yañlışıp, köküs boşluğındaki qırmızı qan damarını sıqqan eken"}
{"score": -0.2031, "min_wscore": -1.204, "n_weak": 0, "char_rate": 7.48, "dur": 6.06, "n_words": 6, "id": "hf_sevil_0632", "text": "Qız namaznı bitirgeninen musafir odasına çıqtı"}
{"score": -0.0939, "min_wscore": -0.245, "n_weak": 0, "char_rate": 5.26, "dur": 3.36, "n_words": 3, "id": "hf_sevil_0660", "text": "Katâ qatıp qaldı"}
{"score": -0.1788, "min_wscore": -0.847, "n_weak": 0, "char_rate": 8.28, "dur": 7.44, "n_words": 11, "id": "hf_sevil_1353", "text": "Aliye biraz oturğan soñ, qara ve eski balaban komod­ğa taba yönedi"}
{"score": -0.0329, "min_wscore": -0.079, "n_weak": 0, "char_rate": 6.29, "dur": 4.56, "n_words": 5, "id": "hf_sevil_1344", "text": "Bazıda bunı da körmey edik"}
{"score": -0.1137, "min_wscore": -0.22, "n_weak": 0, "char_rate": 6.57, "dur": 3.18, "n_words": 2, "id": "hf_sevil_1485", "text": "Musafirimiz olursıñ"}
{"score": -0.114, "min_wscore": -0.569, "n_weak": 0, "char_rate": 7.51, "dur": 8.579, "n_words": 11, "id": "hf_sevil_0641", "text": "Bu cedvelni siz Elşannen tizdiñiz, o öldi, endi sen cevap bereceksiñ"}
{"score": -0.0083, "min_wscore": -0.023, "n_weak": 0, "char_rate": 8.33, "dur": 4.8, "n_words": 6, "id": "hf_sevil_1564", "text": "Bunı körgen erkek, daa ziyade sinirlendi"}
{"score": -0.1553, "min_wscore": -0.784, "n_weak": 0, "char_rate": 8.04, "dur": 7.38, "n_words": 9, "id": "hf_sevil_0402", "text": "Aytqan sözlerim Dinaranı şaşırtqanını bilsem de, maña epbir edi"}
{"score": -0.1331, "min_wscore": -0.185, "n_weak": 0, "char_rate": 6.44, "dur": 3.12, "n_words": 3, "id": "hf_sevil_1030", "text": "Yılan kibi qadınsıñ"}
{"score": -0.1053, "min_wscore": -0.269, "n_weak": 0, "char_rate": 6.07, "dur": 4.86, "n_words": 5, "id": "hf_sevil_0596", "text": "Aqsap, bina artında ğayıp oldı"}
{"score": -0.2377, "min_wscore": -0.752, "n_weak": 0, "char_rate": 8.2, "dur": 4.38, "n_words": 6, "id": "hf_sevil_1539", "text": "Böyle çekişüvlerde bir qaç yıl keçti"}
{"score": -0.1641, "min_wscore": -0.366, "n_weak": 0, "char_rate": 7.88, "dur": 3.42, "n_words": 3, "id": "hf_sevil_0490", "text": "Epimizni cenkten saqlasın"}
{"score": -0.0785, "min_wscore": -0.21, "n_weak": 0, "char_rate": 8.22, "dur": 5.1, "n_words": 6, "id": "hf_sevil_0446", "text": "Bundan soñ rahmetli Elşannen ekimiz qaldıq"}
{"score": -0.2518, "min_wscore": -1.002, "n_weak": 0, "char_rate": 8.38, "dur": 7.14, "n_words": 12, "id": "hf_sevil_0948", "text": "Añlaysıñmı, men mından yaqın bir yuva taptım, anda on tane mışıq bar"}
{"score": -0.1316, "min_wscore": -0.574, "n_weak": 0, "char_rate": 8.39, "dur": 6.84, "n_words": 8, "id": "hf_sevil_1477", "text": "Böyle lezzetli şeylerni soñki sefer memleketinde aşağan edi"}
{"score": -0.0509, "min_wscore": -0.086, "n_weak": 0, "char_rate": 6.07, "dur": 4.08, "n_words": 3, "id": "hf_sevil_0112", "text": "Odanı sessizlik qapladı"}
{"score": -0.0642, "min_wscore": -0.378, "n_weak": 0, "char_rate": 7.75, "dur": 6.36, "n_words": 8, "id": "hf_sevil_1504", "text": "Zemaneviy asırda böyle ömür tarzı ola bilemi, aceba"}
{"score": -0.2816, "min_wscore": -0.86, "n_weak": 0, "char_rate": 9.28, "dur": 6.72, "n_words": 11, "id": "hf_sevil_1558", "text": "Siz daa bir şey aytacaq ola­sıñızmı,  dep kestirdim ve odadan çıqtım"}
{"score": -0.0394, "min_wscore": -0.1, "n_weak": 0, "char_rate": 5.52, "dur": 3.9, "n_words": 3, "id": "hf_sevil_0515", "text": "Onı siz öldürdiñiz"}
{"score": -0.1474, "min_wscore": -0.869, "n_weak": 0, "char_rate": 6.99, "dur": 5.1, "n_words": 7, "id": "hf_sevil_1166", "text": "Biz ise kene ketemiz  qayda yol tutamız"}
{"score": -0.1422, "min_wscore": -0.663, "n_weak": 0, "char_rate": 8.73, "dur": 7.08, "n_words": 10, "id": "hf_sevil_0529", "text": "Menim bayrağım, baq, anda asılı tura, dep qarşıdaki binağa kösterdi"}
{"score": -0.0707, "min_wscore": -0.225, "n_weak": 0, "char_rate": 5.28, "dur": 3.84, "n_words": 3, "id": "hf_sevil_0482", "text": "Bekleñiz, men kelem"}
{"score": -0.0601, "min_wscore": -0.149, "n_weak": 0, "char_rate": 6.75, "dur": 3.959, "n_words": 4, "id": "hf_sevil_0954", "text": "Üç balanıñ babası ağlarmı"}
{"score": -0.0921, "min_wscore": -0.41, "n_weak": 0, "char_rate": 5.65, "dur": 4.08, "n_words": 5, "id": "hf_sevil_1130", "text": "Amma onıñ qabaatı yoq ki"}
{"score": -0.1611, "min_wscore": -0.317, "n_weak": 0, "char_rate": 6.3, "dur": 2.94, "n_words": 2, "id": "hf_sevil_0920", "text": "Qave pişirecegim"}
{"score": -0.2022, "min_wscore": -0.885, "n_weak": 0, "char_rate": 8.99, "dur": 7.86, "n_words": 10, "id": "hf_sevil_0887", "text": "Öz qasevetleriñnen prodüsser ya da ses rejissörınen paylaşıp olamazsıñ da"}
{"score": -0.1696, "min_wscore": -0.768, "n_weak": 0, "char_rate": 8.89, "dur": 9.0, "n_words": 13, "id": "hf_sevil_1153", "text": "Qasevet etmeñiz, hanım, biraz yaramay oldıñız, ekim raat yuqlamaq içün sizge ilâc berdi"}
{"score": -0.0829, "min_wscore": -0.324, "n_weak": 0, "char_rate": 7.71, "dur": 5.88, "n_words": 6, "id": "hf_sevil_1516", "text": "Yazıq, yüregiñe Vatan sevgisini aşlap olamadım"}
{"score": -0.578, "min_wscore": -1.815, "n_weak": 0, "char_rate": 12.21, "dur": 3.96, "n_words": 7, "id": "hf_sevil_0631", "text": "Ekim turdı ve aşıqmayıp halatını tüzetip başladı"}
{"score": -0.072, "min_wscore": -0.277, "n_weak": 0, "char_rate": 6.6, "dur": 4.74, "n_words": 5, "id": "hf_sevil_0510", "text": "Olardan mücizeviy nur saçıla edi"}
{"score": -0.1337, "min_wscore": -0.916, "n_weak": 0, "char_rate": 8.31, "dur": 9.06, "n_words": 10, "id": "hf_sevil_1524", "text": "Tamam bir aftadan soñ gazetalar­dan birisinde hayırlavnı körip, şokqa oğrağandır"}
{"score": -0.1307, "min_wscore": -0.279, "n_weak": 0, "char_rate": 6.07, "dur": 3.3, "n_words": 4, "id": "hf_sevil_1392", "text": "Pek aç oldıñmı yoqsa"}
{"score": -0.0944, "min_wscore": -0.673, "n_weak": 0, "char_rate": 7.78, "dur": 6.6, "n_words": 10, "id": "hf_sevil_0100", "text": "Tek sen şimdi babama bunı aytma, men başta ösmek kerekim"}
{"score": -0.0725, "min_wscore": -0.187, "n_weak": 0, "char_rate": 7.02, "dur": 4.08, "n_words": 4, "id": "hf_sevil_1543", "text": "Bu ayatımnıñ yañı saifesidir"}
{"score": -0.2092, "min_wscore": -0.912, "n_weak": 0, "char_rate": 8.58, "dur": 6.239, "n_words": 8, "id": "hf_sevil_0679", "text": "Şimdi de olar öyle qolay qızçıqnı serbest bıraqmazlar"}
{"score": -0.0895, "min_wscore": -0.749, "n_weak": 0, "char_rate": 7.74, "dur": 8.1, "n_words": 10, "id": "hf_sevil_1479", "text": "Qız ekimniñ hancer sözlerini, sabiyniñ alı, öz oğlunı aqlına ketirdi"}
{"score": -0.1507, "min_wscore": -0.468, "n_weak": 0, "char_rate": 7.17, "dur": 5.88, "n_words": 8, "id": "hf_sevil_0949", "text": "Kim eken bu saatte,  dep Asene qapığa yaqlaştı"}
{"score": -0.177, "min_wscore": -0.719, "n_weak": 0, "char_rate": 6.21, "dur": 6.299, "n_words": 8, "id": "hf_sevil_0774", "text": "Sen, men, bizim dört balamız ve sarı mışıq"}
{"score": -0.1471, "min_wscore": -0.892, "n_weak": 0, "char_rate": 7.75, "dur": 9.18, "n_words": 12, "id": "hf_sevil_0828", "text": "Elbette, qızımnı da ögrettim, amma men, doğrusını aytsam, daa çoq yantıq sevem"}
{"score": -0.1132, "min_wscore": -0.168, "n_weak": 0, "char_rate": 5.65, "dur": 2.94, "n_words": 2, "id": "hf_sevil_0369", "text": "Niayet, yoruldı"}
{"score": -0.1067, "min_wscore": -1.363, "n_weak": 0, "char_rate": 8.44, "dur": 9.96, "n_words": 14, "id": "hf_sevil_1125", "text": "O özüniñ Türkiyesinde ekende, men ne istesem, onı yapabilem, ebet, belli bir vaqıtqa qadar"}
{"score": -0.1395, "min_wscore": -0.248, "n_weak": 0, "char_rate": 5.33, "dur": 3.66, "n_words": 3, "id": "hf_sevil_0504", "text": "Nur başını çevirdi"}
{"score": -0.2093, "min_wscore": -1.098, "n_weak": 0, "char_rate": 9.11, "dur": 9.24, "n_words": 11, "id": "hf_sevil_1446", "text": "Olar, sanki vatan quçağında, biri-birini çoq yıllar körmegen tuvğanlar kibi subetleşeler"}
{"score": -0.1869, "min_wscore": -1.124, "n_weak": 0, "char_rate": 7.82, "dur": 9.66, "n_words": 12, "id": "hf_sevil_1151", "text": "Bir qaç aynıñ içinde ilk kere Seithalil qartbaba öz oğlunıñ sözlerine dayanamadı"}
{"score": -0.1605, "min_wscore": -0.203, "n_weak": 0, "char_rate": 5.15, "dur": 3.12, "n_words": 2, "id": "hf_sevil_1276", "text": "Sen bahtlısıñmı"}
{"score": -0.1276, "min_wscore": -0.508, "n_weak": 0, "char_rate": 7.0, "dur": 5.28, "n_words": 5, "id": "hf_sevil_0988", "text": "Apansızdan kökte yaşın peyda oldı"}
{"score": -0.1561, "min_wscore": -0.216, "n_weak": 0, "char_rate": 5.7, "dur": 4.019, "n_words": 3, "id": "hf_sevil_0561", "text": "Epimiz bunı bilemiz"}
{"score": -0.3234, "min_wscore": -1.033, "n_weak": 0, "char_rate": 9.47, "dur": 4.98, "n_words": 7, "id": "hf_sevil_0935", "text": "Menim qızım aş qazançığını toldurıp,  memnün qalır"}
{"score": -0.0715, "min_wscore": -0.147, "n_weak": 0, "char_rate": 4.67, "dur": 3.96, "n_words": 3, "id": "hf_sevil_0318", "text": "O toqtamay yazdı"}
{"score": -0.1078, "min_wscore": -0.959, "n_weak": 0, "char_rate": 7.67, "dur": 8.82, "n_words": 10, "id": "hf_sevil_0955", "text": "Sen imanlı qızsıñ,  dep başladı aşhaneden Emine,  meni añlamaq mümkünmi"}
{"score": -0.0388, "min_wscore": -0.348, "n_weak": 0, "char_rate": 6.28, "dur": 8.16, "n_words": 9, "id": "hf_sevil_0995", "text": "Efkâr, yanıq, ümütsizlik ve ökünç tolu mavı teren közler"}
{"score": -0.0196, "min_wscore": -0.076, "n_weak": 0, "char_rate": 6.15, "dur": 4.2, "n_words": 5, "id": "hf_sevil_1513", "text": "O babasız ayatnı aq etmedi"}
{"score": -0.2435, "min_wscore": -0.74, "n_weak": 0, "char_rate": 9.12, "dur": 7.8, "n_words": 11, "id": "hf_sevil_0248", "text": "Közleri alışmağanı içün, qap-qara ortalıqta bir şeyler körmege ümüti yoq edi"}
{"score": -0.0431, "min_wscore": -0.488, "n_weak": 0, "char_rate": 8.2, "dur": 7.8, "n_words": 15, "id": "hf_sevil_0859", "text": "Eger qorantada sekiz ve ya on bala olsa, demek olar tolu bir kün suv alalar"}
{"score": -0.3076, "min_wscore": -1.915, "n_weak": 0, "char_rate": 7.04, "dur": 3.299, "n_words": 4, "id": "hf_sevil_0659", "text": "İman göñülde olsa yetti"}
{"score": -0.0797, "min_wscore": -0.379, "n_weak": 0, "char_rate": 8.13, "dur": 7.68, "n_words": 10, "id": "hf_sevil_0785", "text": "Apansızdan olardan biri binalar arasında olğan boş yerge işaret etti"}
{"score": -0.1016, "min_wscore": -0.738, "n_weak": 0, "char_rate": 7.46, "dur": 6.84, "n_words": 9, "id": "hf_sevil_1198", "text": "Sakin ol, teren nefes alıp, yavaştan ne istegeniñni ayt"}
{"score": -0.0427, "min_wscore": -0.15, "n_weak": 0, "char_rate": 6.63, "dur": 6.6, "n_words": 8, "id": "hf_sevil_0540", "text": "O etrafqa ep qaranlıq ve qorqunç darqata edi"}
{"score": -0.7411, "min_wscore": -10.381, "n_weak": 4, "char_rate": 12.44, "dur": 4.62, "n_words": 10, "id": "hf_sevil_0740", "text": "Siz­den biriñiz añlatsın, ne oldı, ne içün bu qadar şamata"}
{"score": -0.1124, "min_wscore": -0.773, "n_weak": 0, "char_rate": 8.57, "dur": 10.02, "n_words": 15, "id": "hf_sevil_1463", "text": "Amma sabiyçik pek yaramadı, ne ağzını açtı, ne de közlerini, bayılğan alda onı mında ketirdik"}
{"score": -0.2272, "min_wscore": -1.167, "n_weak": 0, "char_rate": 6.95, "dur": 4.14, "n_words": 5, "id": "hf_sevil_1311", "text": "Aç qapını, olacaq aqayıñ keldi"}
{"score": -0.0876, "min_wscore": -0.656, "n_weak": 0, "char_rate": 8.61, "dur": 8.94, "n_words": 14, "id": "hf_sevil_0128", "text": "Bilem, o ne yerde olğanı belli degil, amma onı tapıp, mektübimni bermeñizni rica etem"}
{"score": -0.0481, "min_wscore": -0.142, "n_weak": 0, "char_rate": 5.94, "dur": 4.379, "n_words": 5, "id": "hf_sevil_0722", "text": "Allahtan sabır ve küç tiledi"}
{"score": -0.2301, "min_wscore": -0.838, "n_weak": 0, "char_rate": 9.22, "dur": 9.36, "n_words": 14, "id": "hf_sevil_0447", "text": "Doğru nasıl olğanını bilgeniñ içün, çoq şeylerden vazgeçmelisiñ ve bunıñ doğru bir cevabı bar"}
{"score": -0.1434, "min_wscore": -0.664, "n_weak": 0, "char_rate": 8.43, "dur": 7.38, "n_words": 8, "id": "hf_sevil_0650", "text": "Seithalil torunını quçaqladı ve kene ökür-ökür ağ­lamağa başladı"}
{"score": -0.1426, "min_wscore": -0.353, "n_weak": 0, "char_rate": 8.37, "dur": 5.28, "n_words": 8, "id": "hf_sevil_1063", "text": "Balanıñ yanında bir de bir vesiqalar bar edimi"}
{"score": -0.0409, "min_wscore": -0.08, "n_weak": 0, "char_rate": 5.21, "dur": 4.44, "n_words": 5, "id": "hf_sevil_0986", "text": "Bugün ava suvuq ve dımlı"}
{"score": -0.1375, "min_wscore": -0.595, "n_weak": 0, "char_rate": 8.09, "dur": 9.78, "n_words": 13, "id": "hf_sevil_0553", "text": "Selime aq­qan közyaşlarını silip, devam etti: aramızdaki bağnı, bu ince yipek yipni üzme"}
{"score": -0.0482, "min_wscore": -0.4, "n_weak": 0, "char_rate": 8.27, "dur": 5.999, "n_words": 10, "id": "hf_sevil_0460", "text": "Biz de inanamız, amma o qadar teren dalmasaq da olur"}
{"score": -0.1889, "min_wscore": -0.454, "n_weak": 0, "char_rate": 6.01, "dur": 3.72, "n_words": 4, "id": "hf_sevil_0734", "text": "Pek qıymetlidir bu yer"}
{"score": -0.0846, "min_wscore": -0.453, "n_weak": 0, "char_rate": 7.55, "dur": 4.439, "n_words": 7, "id": "hf_sevil_0046", "text": "Ah, saña bularnı ne içün aytam eken"}
{"score": -0.1097, "min_wscore": -0.743, "n_weak": 0, "char_rate": 7.6, "dur": 11.1, "n_words": 16, "id": "hf_sevil_1387", "text": "Ava bulutlı olsa da, biz  men, Emil ve Ekremçik  balıq tutmaq içün özenge barmağa azırlana edik"}
{"score": -0.0813, "min_wscore": -0.284, "n_weak": 0, "char_rate": 7.23, "dur": 6.84, "n_words": 6, "id": "hf_sevil_1510", "text": "Elindeki şem­siyesinen balanı olğan küçünen türtti"}
{"score": -0.0617, "min_wscore": -0.348, "n_weak": 0, "char_rate": 6.95, "dur": 4.98, "n_words": 8, "id": "hf_sevil_0028", "text": "Aliye hanım, bugün ne de yahşı ava bar"}
{"score": -0.149, "min_wscore": -0.645, "n_weak": 0, "char_rate": 8.08, "dur": 5.88, "n_words": 8, "id": "hf_sevil_1565", "text": "Bitaçıqnıñ urbası sade, amma tertip ve nizamda edi"}
{"score": -0.0697, "min_wscore": -0.303, "n_weak": 0, "char_rate": 6.37, "dur": 4.56, "n_words": 6, "id": "hf_sevil_0445", "text": "Avanıñ biznen ne alâqası bar ya"}
{"score": -0.1268, "min_wscore": -0.798, "n_weak": 0, "char_rate": 5.69, "dur": 7.38, "n_words": 10, "id": "hf_sevil_0726", "text": "Amma o ne ögge, ne artqa bir adım yapıp olamadı"}
{"score": -0.353, "min_wscore": -0.974, "n_weak": 0, "char_rate": 8.48, "dur": 8.459, "n_words": 11, "id": "hf_sevil_1518", "text": "Aliye yerde qıbırdamayıp yatqan yapraçıqqa baqıp: Mına sen de raatlıq taptıñ"}
{"score": -0.098, "min_wscore": -0.543, "n_weak": 0, "char_rate": 8.7, "dur": 4.86, "n_words": 6, "id": "hf_sevil_0745", "text": "Ömrümde böyle dülber çoqraq körmegen edim"}
