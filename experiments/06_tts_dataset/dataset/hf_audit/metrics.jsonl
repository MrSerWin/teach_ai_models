{"score": -0.1005, "min_wscore": -0.226, "n_weak": 0, "char_rate": 6.85, "dur": 3.54, "n_words": 5, "id": "hf_sevil_1562", "text": "Yoq, telefonı da yoq edi"}
{"score": -0.087, "min_wscore": -0.313, "n_weak": 0, "char_rate": 6.55, "dur": 3.96, "n_words": 5, "id": "hf_sevil_0347", "text": "Yaş canı toymay, azat oldı"}
{"score": -0.1292, "min_wscore": -0.29, "n_weak": 0, "char_rate": 6.55, "dur": 3.36, "n_words": 3, "id": "hf_sevil_0209", "text": "Yapqanıñ zina sayılır"}
{"score": -0.1223, "min_wscore": -0.794, "n_weak": 0, "char_rate": 8.0, "dur": 6.6, "n_words": 7, "id": "hf_sevil_0387", "text": "Dükül­degen yüregi köküs qafesinden atılıp çıqacaq edi"}
