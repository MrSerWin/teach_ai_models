{"score": -0.0492, "min_wscore": -0.527, "n_weak": 0, "char_rate": 5.53, "dur": 4.5, "n_words": 4, "id": "hf_sevil_0642", "text": "Bese-belli bir şey olğan"}
{"score": -0.1261, "min_wscore": -0.48, "n_weak": 0, "char_rate": 8.97, "dur": 5.939, "n_words": 7, "id": "hf_sevil_0762", "text": "Ya men yırlağan türkülerni kita­plardan aldımmı yoqsa"}
{"score": -0.265, "min_wscore": -1.195, "n_weak": 0, "char_rate": 8.25, "dur": 8.34, "n_words": 10, "id": "hf_sevil_1079", "text": "Ortalıqta yüz bergen vaqialar yüregini sıqa, soñsız qay­ğılar bağrını yaqa"}
{"score": -2.3317, "min_wscore": -5.192, "n_weak": 6, "char_rate": 28.49, "dur": 2.88, "n_words": 7, "id": "hf_sevil_0423", "text": "O, yerinden sıçrap tayaçığınen sallamağa başladı:  Olmaz"}
{"score": -0.2444, "min_wscore": -0.99, "n_weak": 0, "char_rate": 9.14, "dur": 6.48, "n_words": 8, "id": "hf_sevil_1271", "text": "Yolnıñ başqa tarafına keçkende, artından kelgen seslerni duydı"}
