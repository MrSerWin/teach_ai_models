{"score": -0.042, "min_wscore": -0.235, "n_weak": 0, "char_rate": 9.07, "dur": 8.1, "n_words": 7, "id": "hf_sevil_1070", "text": "Demirci­niñ eski manzaraları, baba-dedelerniñ gençlik devrindeki süretleri"}
{"score": -0.0425, "min_wscore": -0.103, "n_weak": 0, "char_rate": 5.2, "dur": 4.68, "n_words": 3, "id": "hf_sevil_0024", "text": "Manasız, adaletsiz ölüm"}
{"score": -0.2328, "min_wscore": -0.481, "n_weak": 0, "char_rate": 8.88, "dur": 4.92, "n_words": 5, "id": "hf_sevil_0081", "text": "Şimdilik onı mahsus palatağa yerleştiriñiz"}
{"score": -0.0864, "min_wscore": -0.608, "n_weak": 0, "char_rate": 8.65, "dur": 5.16, "n_words": 6, "id": "hf_sevil_0782", "text": "Bizim erkeklerimiz beceriksiz ve aptal ekenler"}
{"score": -0.0743, "min_wscore": -0.144, "n_weak": 0, "char_rate": 5.21, "dur": 3.6, "n_words": 2, "id": "hf_sevil_1041", "text": "Bilgeniñiz çadır"}
{"score": -0.1981, "min_wscore": -1.067, "n_weak": 0, "char_rate": 8.64, "dur": 7.32, "n_words": 8, "id": "hf_sevil_1004", "text": "Quturğan Mulkay Dideni boş qoymay, öldürmek niyetinden vazgeçmey"}
