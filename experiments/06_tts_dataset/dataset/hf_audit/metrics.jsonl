{"score": -0.2245, "min_wscore": -0.87, "n_weak": 0, "char_rate": 10.17, "dur": 5.459, "n_words": 9, "id": "hf_sevil_1447", "text": "Bir oğlan yanına çapıp, olğan küçü ile tizlerine yandırdı"}
{"score": -0.0553, "min_wscore": -0.172, "n_weak": 0, "char_rate": 7.87, "dur": 3.24, "n_words": 3, "id": "hf_sevil_0616", "text": "Men sözümde turalmadım"}
{"score": -2.1889, "min_wscore": -7.05, "n_weak": 9, "char_rate": 26.14, "dur": 3.6, "n_words": 12, "id": "hf_sevil_0558", "text": "Turistler yolnıñ başqa tarafına keçip, uzaqtan körgen manzaranı yaqından seyir ete bildiler"}
{"score": -0.0823, "min_wscore": -0.131, "n_weak": 0, "char_rate": 5.95, "dur": 3.96, "n_words": 2, "id": "hf_sevil_0583", "text": "Ana-babası, yaqınları"}
{"score": -0.1094, "min_wscore": -0.572, "n_weak": 0, "char_rate": 8.33, "dur": 9.66, "n_words": 10, "id": "hf_sevil_0203", "text": "Dağlarnıñ töpesinde, taşlar üstünde ösken terekler tabiatnıñ acayipligini aks etmekte"}
{"score": -0.0785, "min_wscore": -0.117, "n_weak": 0, "char_rate": 3.87, "dur": 3.839, "n_words": 3, "id": "hf_sevil_0124", "text": "Kel laf eteyik"}
{"score": -0.0789, "min_wscore": -0.349, "n_weak": 0, "char_rate": 5.17, "dur": 4.8, "n_words": 5, "id": "hf_sevil_1296", "text": "Ve kene red cevabını aldı"}
{"score": -0.0916, "min_wscore": -0.287, "n_weak": 0, "char_rate": 8.89, "dur": 4.92, "n_words": 6, "id": "hf_sevil_0091", "text": "Elektroşokerni alıp, onı özüne ketirecek oldı"}
{"score": -0.1039, "min_wscore": -0.167, "n_weak": 0, "char_rate": 7.25, "dur": 4.5, "n_words": 5, "id": "hf_sevil_0284", "text": "Aliye defterni kene yerine qoydı"}
{"score": -0.1022, "min_wscore": -0.489, "n_weak": 0, "char_rate": 6.77, "dur": 5.819, "n_words": 6, "id": "hf_sevil_1072", "text": "Şlâpalı adamnıñ burnuna aş qoqusı keldi"}
{"score": -0.1313, "min_wscore": -0.495, "n_weak": 0, "char_rate": 6.65, "dur": 6.96, "n_words": 6, "id": "hf_sevil_0102", "text": "Balam, evlâdım, olarnıñ qarğışları saña tiydimi"}
{"score": -0.1121, "min_wscore": -0.344, "n_weak": 0, "char_rate": 7.82, "dur": 4.86, "n_words": 5, "id": "hf_sevil_1454", "text": "Bürküdniñ başına sanki qaya avdarıldı"}
{"score": -0.2125, "min_wscore": -0.978, "n_weak": 0, "char_rate": 9.04, "dur": 5.88, "n_words": 9, "id": "hf_sevil_0418", "text": "Tasavur etesiñmi, bir kereden ne qadar torun olur sende"}
{"score": -1.2002, "min_wscore": -9.736, "n_weak": 4, "char_rate": 16.56, "dur": 3.9, "n_words": 8, "id": "hf_sevil_1334", "text": "Tolu salonnıñ adamları şaqalaşıp, vaqtını şeñ keçire ediler"}
{"score": -1.6654, "min_wscore": -11.728, "n_weak": 9, "char_rate": 17.23, "dur": 5.76, "n_words": 15, "id": "hf_sevil_1402", "text": "Dide ise ep susamay, kösterilgen basqıdan, onıñ ağzından daa çoq küfür ve çirkin sözler fışqıra"}
{"score": -0.0665, "min_wscore": -0.207, "n_weak": 0, "char_rate": 7.97, "dur": 6.66, "n_words": 7, "id": "hf_sevil_0800", "text": "Kontsert ve gastrollerden bile vazgeçmege mecbur oldım"}
{"score": -0.3138, "min_wscore": -1.416, "n_weak": 0, "char_rate": 8.26, "dur": 7.62, "n_words": 8, "id": "hf_sevil_0575", "text": "E, şimdi haberlerde kene Qırımnıñ Rusiyege qoşu­lacağını ayttılar"}
{"score": -0.1866, "min_wscore": -0.804, "n_weak": 0, "char_rate": 8.33, "dur": 7.68, "n_words": 12, "id": "hf_sevil_0963", "text": "E, kene o qoqu aqlıma keldi, —  dep, duyğanıma  qulaq asmamağa çalıştım"}
{"score": -0.2065, "min_wscore": -1.329, "n_weak": 0, "char_rate": 8.38, "dur": 7.32, "n_words": 8, "id": "hf_sevil_1495", "text": "Aliye közyaşlarını tıyıp olamağanından toqtadı, ağır nefes aldı"}
{"score": -0.1719, "min_wscore": -0.25, "n_weak": 0, "char_rate": 5.37, "dur": 3.12, "n_words": 2, "id": "hf_sevil_0399", "text": "Sen mındasıñmı"}
{"score": -0.096, "min_wscore": -0.224, "n_weak": 0, "char_rate": 6.79, "dur": 4.44, "n_words": 3, "id": "hf_sevil_0569", "text": "Öz-özüñizni masqara etmeñiz"}
{"score": -0.1335, "min_wscore": -0.39, "n_weak": 0, "char_rate": 6.46, "dur": 3.9, "n_words": 4, "id": "hf_sevil_0304", "text": "Adı kerek degil, kadâm"}
{"score": -0.1459, "min_wscore": -0.822, "n_weak": 0, "char_rate": 8.33, "dur": 7.919, "n_words": 10, "id": "hf_sevil_1287", "text": "Qartbaba,  yavaştan fısıldadı torunı,  sen ağ­lama, menim bir planım bar"}
{"score": -0.15, "min_wscore": -0.72, "n_weak": 0, "char_rate": 7.89, "dur": 8.64, "n_words": 11, "id": "hf_sevil_0484", "text": "Küçlü eller ve omuzlar qart yerli halqnıñ mağrur oğlu olğanını isbatlamaqta"}
{"score": -0.1797, "min_wscore": -1.193, "n_weak": 0, "char_rate": 8.79, "dur": 7.62, "n_words": 11, "id": "hf_sevil_0422", "text": "Bilem, sen Qırımnı iç bir vaqıt sevmegen ediñ, onıñ qıymetini bilemediñ"}
{"score": -0.1734, "min_wscore": -0.422, "n_weak": 0, "char_rate": 7.97, "dur": 4.02, "n_words": 4, "id": "hf_sevil_0830", "text": "Gecelernen turıp, Oña yalvarayıq"}
{"score": -0.1597, "min_wscore": -0.712, "n_weak": 0, "char_rate": 8.7, "dur": 7.98, "n_words": 10, "id": "hf_sevil_0648", "text": "O birden bütün küç-qudretini toplap, çeşmege doğru ateş oqlarını yöneltti"}
{"score": -0.1019, "min_wscore": -0.169, "n_weak": 0, "char_rate": 5.51, "dur": 3.06, "n_words": 2, "id": "hf_sevil_0307", "text": "Nefesim tutuldı"}
{"score": -0.1048, "min_wscore": -0.438, "n_weak": 0, "char_rate": 6.07, "dur": 5.52, "n_words": 8, "id": "hf_sevil_0280", "text": "O bizge em imtian bere, em yolnı aça"}
{"score": -0.1443, "min_wscore": -1.087, "n_weak": 0, "char_rate": 7.63, "dur": 11.82, "n_words": 18, "id": "hf_sevil_0624", "text": "Nur bu ailede ekinci bala edi, ve o, ondan soñ olğan daa eki qardaşını büyük mesülietliknen baqa edi"}
{"score": -0.2298, "min_wscore": -0.759, "n_weak": 0, "char_rate": 8.48, "dur": 6.12, "n_words": 9, "id": "hf_sevil_0977", "text": "Bir qaç daqiqadan soñ qartiy cebinden boş paket çıqardı"}
{"score": -0.1781, "min_wscore": -0.46, "n_weak": 0, "char_rate": 8.57, "dur": 6.48, "n_words": 7, "id": "hf_sevil_1385", "text": "O, yerinden sıçrap tayaçığınen sallamağa başladı:  Olmaz"}
{"score": -0.0745, "min_wscore": -0.105, "n_weak": 0, "char_rate": 6.41, "dur": 3.54, "n_words": 4, "id": "hf_sevil_0907", "text": "İman göñülde olsa yetti"}
{"score": -0.1004, "min_wscore": -0.14, "n_weak": 0, "char_rate": 5.66, "dur": 3.779, "n_words": 3, "id": "hf_sevil_1337", "text": "Zavallı Azim qaraman"}
{"score": -0.0675, "min_wscore": -0.285, "n_weak": 0, "char_rate": 6.89, "dur": 3.96, "n_words": 5, "id": "hf_sevil_0172", "text": "Men daa bir şey imzalamadım"}
{"score": -0.0084, "min_wscore": -0.093, "n_weak": 0, "char_rate": 6.75, "dur": 6.0, "n_words": 7, "id": "hf_sevil_0082", "text": "Sen istersiñ de, men yapmammı, bir danem"}
{"score": -0.0174, "min_wscore": -0.109, "n_weak": 0, "char_rate": 6.25, "dur": 5.1, "n_words": 6, "id": "hf_sevil_1497", "text": "Ana, baba, men sizlerni pek sevem"}
{"score": -0.0965, "min_wscore": -0.363, "n_weak": 0, "char_rate": 8.22, "dur": 4.8, "n_words": 5, "id": "hf_sevil_1105", "text": "Ocam, siz hastalar baquvını bitirdiñizmi"}
{"score": -0.0818, "min_wscore": -0.322, "n_weak": 0, "char_rate": 5.79, "dur": 4.319, "n_words": 4, "id": "hf_sevil_1259", "text": "Qozuçıqlar bir özü otlana"}
{"score": -0.1441, "min_wscore": -0.402, "n_weak": 0, "char_rate": 4.85, "dur": 3.42, "n_words": 2, "id": "hf_sevil_0320", "text": "Qaveñ kerekmey"}
{"score": -0.1436, "min_wscore": -0.526, "n_weak": 0, "char_rate": 7.74, "dur": 7.86, "n_words": 10, "id": "hf_sevil_1419", "text": "Allah senden biñlerce razı olsun, amma men, kerçek aytam, toqım"}
{"score": -0.0629, "min_wscore": -0.203, "n_weak": 0, "char_rate": 7.43, "dur": 5.94, "n_words": 6, "id": "hf_sevil_0216", "text": "Amma istegine irişemedi, geberip ketti biçare"}
{"score": -0.2113, "min_wscore": -0.785, "n_weak": 0, "char_rate": 9.57, "dur": 8.76, "n_words": 8, "id": "hf_sevil_1001", "text": "Terekler­deki yapraqlar nasıldır telükeniñ yaqınlaşqanını sezgendayın titrep başladılar"}
{"score": -0.1468, "min_wscore": -0.401, "n_weak": 0, "char_rate": 7.8, "dur": 4.32, "n_words": 6, "id": "hf_sevil_1107", "text": "O nedendir oña pek bahtsız köründi"}
{"score": -0.0465, "min_wscore": -0.208, "n_weak": 0, "char_rate": 7.18, "dur": 4.08, "n_words": 7, "id": "hf_sevil_1180", "text": "Amma bu dünyanıñ da öz tadı bar"}
{"score": -0.06, "min_wscore": -0.277, "n_weak": 0, "char_rate": 7.66, "dur": 4.671, "n_words": 4, "id": "hf_sevil_0435", "text": "Bunı sizden beklemedim, mühlislerim"}
{"score": -0.056, "min_wscore": -0.265, "n_weak": 0, "char_rate": 6.97, "dur": 8.76, "n_words": 11, "id": "hf_sevil_0134", "text": "Hususan bugün o özüni inanılmaz derecede yañğız ve tüşkün duya edi"}
{"score": -0.1931, "min_wscore": -0.874, "n_weak": 0, "char_rate": 8.06, "dur": 5.04, "n_words": 6, "id": "hf_sevil_0332", "text": "Yañı qaideler çıqarğan, sen kim olğansıñ"}
{"score": -0.1147, "min_wscore": -0.127, "n_weak": 0, "char_rate": 5.2, "dur": 3.3, "n_words": 2, "id": "hf_sevil_1509", "text": "Anda oturırsıñ"}
{"score": -0.2003, "min_wscore": -0.751, "n_weak": 0, "char_rate": 8.97, "dur": 5.22, "n_words": 7, "id": "hf_sevil_1411", "text": "Aydı, çekiliñiz, çekiliñiz, ne qatıp qaldıñız ya"}
