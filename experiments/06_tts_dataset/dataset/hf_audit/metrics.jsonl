{"score": -0.0707, "min_wscore": -0.181, "n_weak": 0, "char_rate": 6.36, "dur": 2.88, "n_words": 3, "id": "hf_sevil_0092", "text": "Mına saña haberim"}
{"score": -0.0699, "min_wscore": -0.223, "n_weak": 0, "char_rate": 5.7, "dur": 4.5, "n_words": 4, "id": "hf_sevil_0051", "text": "Yoq, bu suriyelige beñzey"}
{"score": -0.0642, "min_wscore": -0.344, "n_weak": 0, "char_rate": 4.83, "dur": 3.54, "n_words": 3, "id": "hf_sevil_0746", "text": "Neni, ocam, neni"}
{"score": -0.1394, "min_wscore": -0.865, "n_weak": 0, "char_rate": 5.56, "dur": 2.64, "n_words": 3, "id": "hf_sevil_1127", "text": "Elbet de menim"}
{"score": -0.1688, "min_wscore": -0.639, "n_weak": 0, "char_rate": 10.14, "dur": 9.3, "n_words": 13, "id": "hf_sevil_1397", "text": "Şaşmalağan kibi, başıña kelip turğan variantlarnı seslendirerek, Osman ağağa tek umuyütnen baqa edi"}
{"score": -1.7336, "min_wscore": -7.444, "n_weak": 6, "char_rate": 18.18, "dur": 4.38, "n_words": 11, "id": "hf_sevil_0597", "text": "Bir qaç daqqadan o, cenazede körgen qadınnı yaqından diqqatlıca közden keçirdi"}
{"score": -0.0816, "min_wscore": -0.184, "n_weak": 0, "char_rate": 6.73, "dur": 3.711, "n_words": 3, "id": "hf_sevil_0406", "text": "Odanı sessizlik qapladı"}
{"score": -0.2085, "min_wscore": -0.666, "n_weak": 0, "char_rate": 6.65, "dur": 6.84, "n_words": 7, "id": "hf_sevil_1195", "text": "Men yañ­lış, aqılsız, tek özümni tüşünip yaşadım"}
{"score": -0.2307, "min_wscore": -0.913, "n_weak": 0, "char_rate": 8.46, "dur": 7.13, "n_words": 7, "id": "hf_sevil_0598", "text": "Vaqıtsız qırılğan şemsiyesini asabiy şekilde elinde sallamaqta"}
{"score": -0.129, "min_wscore": -0.903, "n_weak": 0, "char_rate": 7.61, "dur": 10.38, "n_words": 12, "id": "hf_sevil_0574", "text": "Zavallı, hucur adamlar, qaç yıl dua etip, niayet, Allahtan mücize olğanına inanmadılar"}
