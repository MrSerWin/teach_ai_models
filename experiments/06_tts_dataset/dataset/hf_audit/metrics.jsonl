{"score": -0.1878, "min_wscore": -0.985, "n_weak": 0, "char_rate": 8.91, "dur": 8.28, "n_words": 10, "id": "hf_sevil_0787", "text": "Merhumeniñ yedisi keçken soñ Mediyevler eviniñ ögünde yük maşinalar toqtaldı"}
{"score": -0.1021, "min_wscore": -0.142, "n_weak": 0, "char_rate": 5.51, "dur": 3.42, "n_words": 2, "id": "hf_sevil_0839", "text": "Sağanaq başlandı"}
{"score": -0.0737, "min_wscore": -0.236, "n_weak": 0, "char_rate": 8.66, "dur": 5.039, "n_words": 5, "id": "hf_sevil_1012", "text": "Buzlap ölse­ler, yazıq-günâh olur dedim"}
{"score": -0.1823, "min_wscore": -0.402, "n_weak": 0, "char_rate": 6.73, "dur": 5.04, "n_words": 3, "id": "hf_sevil_1148", "text": "Epimizni suvsuzlıqtan qurtardı"}
{"score": -0.0991, "min_wscore": -0.336, "n_weak": 0, "char_rate": 7.73, "dur": 7.62, "n_words": 9, "id": "hf_sevil_0170", "text": "Mında esasen lezgiler yaşay edi, olarnen tez arada dostlaştıq"}
{"score": -1.1897, "min_wscore": -4.89, "n_weak": 5, "char_rate": 13.07, "dur": 4.619, "n_words": 8, "id": "hf_sevil_1022", "text": "Niayet, art oturğıçtan, fışnap-fışnap, şişman bir qız çıqtı"}
{"score": -0.0421, "min_wscore": -0.151, "n_weak": 0, "char_rate": 6.36, "dur": 5.04, "n_words": 7, "id": "hf_sevil_0180", "text": "Maña daa sağ ol dersiñ sen, Mulkay"}
{"score": -0.1753, "min_wscore": -0.847, "n_weak": 0, "char_rate": 7.59, "dur": 7.98, "n_words": 8, "id": "hf_sevil_0079", "text": "Quşçıqlar çivildeşmekte, ükümran baar özüni qı­raliçe kibi duya"}
