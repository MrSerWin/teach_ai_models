{"score": -0.0421, "min_wscore": -0.096, "n_weak": 0, "char_rate": 6.79, "dur": 4.2, "n_words": 4, "id": "hf_sevil_1010", "text": "Birden oda sakinligi bozuldı"}
{"score": -0.0779, "min_wscore": -0.59, "n_weak": 0, "char_rate": 6.91, "dur": 6.119, "n_words": 7, "id": "hf_sevil_1099", "text": "Elbette, o memleketindekine iç te oşamay edi"}
