{"score": -0.2585, "min_wscore": -0.838, "n_weak": 0, "char_rate": 8.57, "dur": 9.6, "n_words": 10, "id": "hf_sevil_1091", "text": "Sanki aqlını coyğan ekimni oğlundan uzaqlaştırdılar, mecburen ine urıp, tınçlandırdılar"}
{"score": -0.2528, "min_wscore": -0.601, "n_weak": 0, "char_rate": 8.07, "dur": 3.54, "n_words": 3, "id": "hf_sevil_0855", "text": "Planlaşqanımız kibi yaparmız"}
{"score": -0.173, "min_wscore": -0.48, "n_weak": 0, "char_rate": 8.17, "dur": 4.74, "n_words": 5, "id": "hf_sevil_0201", "text": "Yaqın­ları tapılsa, soñ baqıp olurmız"}
{"score": -0.0834, "min_wscore": -0.354, "n_weak": 0, "char_rate": 5.0, "dur": 4.26, "n_words": 3, "id": "hf_sevil_1322", "text": "Canım qurban olmasın"}
{"score": -0.247, "min_wscore": -0.944, "n_weak": 0, "char_rate": 7.46, "dur": 7.68, "n_words": 10, "id": "hf_sevil_0816", "text": "Yoq, tize, siz kibi usta aşçığa yemek satıp, para qa­zanırımmı"}
