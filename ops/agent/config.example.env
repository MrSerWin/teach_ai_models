# Control plane on the NAS. Use the TAILSCALE name so it works off-LAN too.
TTS_CONTROL=http://servin-backup:8080
TTS_TOKEN=change-me-to-a-long-random-string
TTS_HOST=win-train

# Paths on the box
TTS_REPO=/home/servin/teach_ai_models
ST2_DIR=/home/servin/StyleTTS2
CONDA_SH=/home/servin/miniconda3/etc/profile.d/conda.sh
CONDA_ENV=qrimtatar_tts
ESPEAK_DATA_PATH=/home/servin/.local/share/espeak-ng-data
DISK_PATH=/mnt/c
NVIDIA_SMI=/usr/lib/wsl/lib/nvidia-smi

# Auto-render probes on every Nth checkpoint, on the CPU, while training keeps
# the GPU. 0 disables. This is what removes "stop training to listen".
AUTO_SYNTH_EVERY=10
AUTO_SYNTH_PROBES=q_carrier.lat.json
