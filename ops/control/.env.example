# Shared secret between the control plane and the box agent.
TTS_TOKEN=change-me-to-a-long-random-string

# Telegram alerts (optional but recommended — this is how you learn the box died).
TG_BOT_TOKEN=
TG_CHAT_ID=

# Wake-on-LAN: MAC of the GPU box's NIC (find it once the machine is back).
BOX_MAC=
BOX_BROADCAST=10.0.0.255

# Consider the box offline after this many seconds without a heartbeat.
OFFLINE_AFTER_SEC=180
# Warn when the box's /mnt/c drops below this (checkpoints are ~2 GB each).
DISK_WARN_GB=50
